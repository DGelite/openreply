# ==============================================================================
# OPENREPLY SAAS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# راهنمای پیکربندی متغیرهای محیطی سیستم مستقل OpenReply
#
# دستورالعمل امنیتی:
# ۱. این فایل را با نام '.env' در ریشه پروژه کپی کنید: cp .env.example .env
# ۲. مقادیر نمونه را با مقادیر واقعی محیط خود جایگزین نمایید.
# ۳. فایل '.env' حاوی اطلاعات حساس است و هرگز نباید وارد گیت (Git) شود.
# ==============================================================================

# ==============================================================================
# ۱. مدیریت و تفکیک پورت‌ها (PORT ISOLATION - بدون تداخل با سیستم رزرو)
# ==============================================================================
# توجه بسیار مهم:
# - پورت‌های ۸۰ و ۸۰۰۰ متعلق به وب‌سرور سیستم رزرو (WAMP / Apache / Nginx) است.
# - پورت‌های ۳۳۰۶ و ۳۳۰۹ متعلق به دیتابیس سیستم رزرو (MySQL / MariaDB) است.
# - پروژه OpenReply نباید تحت هیچ شرایطی این پورت‌ها را اشغال کند.
#
# پورت وب‌سرور OpenReply (پیش‌فرض: 3000 | گزینه‌های جایگزین: 3001 یا 8080)
PORT=3000

# پورت هاست دیتابیس OpenReply برای دسترسی محلی (پیش‌فرض: 3308 | جایگزین: 3310)
# دیتابیس فقط به لوپ‌بک (127.0.0.1) بایند می‌شود و هرگز در اینترنت باز نمی‌گردد.
DB_PORT=3308

# ==============================================================================
# ۲. هسته اپلیکیشن و احراز هویت (NextAuth v5 & Security)
# ==============================================================================
# آدرس اصلی دسترسی به سامانه:
# در محیط توسعه محلی: http://localhost:3000
# در سرور پروداکشن:  https://insta.digitalelite.ir
NEXTAUTH_URL=http://localhost:3000

# کلید تصادفی امن برای رمزنگاری سشن‌ها و توکن‌های NextAuth (حداقل ۳۲ کاراکتر)
# دستور تولید کلید در ترمینال: openssl rand -hex 32
NEXTAUTH_SECRET=generate_with_openssl_rand_hex_32_chars_min
AUTH_SECRET=generate_with_openssl_rand_hex_32_chars_min
AUTH_TRUST_HOST=true

# توکن امنیتی برای اجرای تسک‌های زمان‌بندی‌شده و کران‌جاب‌ها (/api/cron/...)
CRON_SECRET=generate_strong_random_secret_for_cron_jobs

# کلید هگزادسیمال ۶۴ کاراکتری برای رمزنگاری ۲ طرفه توکن‌های اینستاگرام (AES-256)
# دستور تولید: openssl rand -hex 32 (که رشته‌ای ۶۴ کاراکتری تولید می‌کند)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==============================================================================
# ۳. دیتابیس اختصاصی (MariaDB / MySQL اختصاصی OpenReply)
# ==============================================================================
# این سرویس دیتابیس مستقل خود را دارد و مستقیماً به دیتابیس سیستم رزرو وصل نمی‌شود.
#
# در حالت اجرای محلی بدون داکر (ارتباط به کانتینر یا دیتابیس لوکال روی پورت ۳۳۰۸):
DATABASE_URL="mysql://openreply:openreply_secure_password@127.0.0.1:3308/digitale_digitaleliteisntal"

# متغیرهای راه‌اندازی کانتینر دیتابیس MariaDB در Docker Compose:
DB_NAME=digitale_digitaleliteisntal
DB_USER=openreply
DB_PASS=openreply_secure_password
DB_ROOT_PASSWORD=mariadb_root_secure_password

# اختیاری: در صورتی که داکر بخواهد به دیتابیس اکسترنال وصل شود
# DOCKER_DATABASE_URL=mysql://openreply:openreply_secure_password@mysql:3306/digitale_digitaleliteisntal

# حداکثر کانکشن‌های استخر دیتابیس
DB_CONNECTION_LIMIT=10

# ==============================================================================
# ۴. ارتباط با سیستم رزرواسیون و CRM (پل ارتباطی مستقل REST API / Webhook)
# ==============================================================================
# فعال/غیرفعال‌سازی پل ارتباطی با سیستم رزرواسیون (false = عملکرد کاملاً مستقل و ایزوله)
PHP_BOOKING_ENABLED=true

# آدرس وب‌سرویس سیستم رزرو (Single-Server vs Multi-Server):
# حالت ۱: اجرای تک‌سروری با داکر (کانتینر به WAMP/Apache هاست روی پورت ۸۰ یا ۸۰۰۰ متصل می‌شود):
# BOOKING_API_URL=http://host.docker.internal/api_openreply.php
# حالت ۲: اجرای توسعه محلی مستقیم روی هاست (npm run dev):
# BOOKING_API_URL=http://localhost/api_openreply.php
# حالت ۳: اجرای چندسروری (Multi-Server - سیستم رزرو روی سرور مجزا قرار دارد):
BOOKING_API_URL=http://localhost/api_openreply.php
PHP_ADMIN_API_URL=http://localhost/api_openreply.php

# کلید رمز مشترک برای احراز هویت HMAC-SHA256 و وب‌هوک‌های دوطرفه بین دو سیستم
# تمامی داده‌های تبادلی با این کلید امضا و اعتبارسنجی می‌شوند
PHP_ADMIN_API_SECRET=shared_secret_between_openreply_and_booking_min_32_chars
OPENREPLY_WEBHOOK_SECRET=shared_secret_between_openreply_and_booking_min_32_chars

# ==============================================================================
# ۵. متا و اینستاگرام (Meta Graph API v25.0 & Webhooks)
# ==============================================================================
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# توکن تایید وب‌هوک متا (تنظیم‌شده در پنل Meta Developer Portal)
WEBHOOK_VERIFY_TOKEN=your_secure_meta_webhook_verify_token_here

# ==============================================================================
# ۶. ارائه‌دهندگان هوش مصنوعی (Google Gemini & OpenAI Smart Reply Engine)
# ==============================================================================
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# ۷. وب‌سرویس پیامک و اعلان‌ها (SMS.ir / Kavenegar)
# ==============================================================================
# حالات ارسال پیامک:
# DIRECT: ارسال مستقیم از طریق sms.ir
# PHP_PROXY: ارسال از طریق سیستم رزرو
# HYBRID: ارسال مستقیم با قابلیت فال‌بک خودکار به سیستم رزرو
SMS_INTEGRATION_MODE=HYBRID
SMS_IR_API_KEY=your_sms_ir_api_key_here
SMS_IR_LINE_NUMBER=3000xxxxxxxx
SMS_IR_TEMPLATE_ID=100000
# KAVENEGAR_API_KEY=your_kavenegar_api_key_here

# ==============================================================================
# ۸. ایمیل‌های سیستمی و ورود جادویی (Resend Magic Links)
# ==============================================================================
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Digital Elite <onboarding@resend.dev>"

# ==============================================================================
# ۹. درگاه پرداخت (زرین‌پال)
# ==============================================================================
ZARRINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ==============================================================================
# ۱۰. تنظیمات ورکر پردازش صف و پیام‌ها (Background Worker)
# ==============================================================================
# اجرای ورکر در فرآیند مجزا (در داکر یا PM2 مقدار true قرار می‌گیرد)
WORKER_STANDALONE=false
DISABLE_INTERNAL_WORKER=false

# نرخ پردازش صف
WORKER_BATCH_SIZE=15
WORKER_JOB_STAGGER_MS=500
WORKER_POLL_MIN_MS=500
WORKER_POLL_MAX_MS=2500

# تنظیمات پایش و بازیابی کامنت‌های اینستاگرام (Safety Net)
COMMENT_POLL_INTERVAL_MS=300000
COMMENT_POLL_LOOKBACK_HOURS=72
COMMENT_POLL_MAX_PER_SWEEP=30

# آدرس ارسال وب‌هوک خروجی لیدها به CRM خارجی (اختیاری)
# OUTBOUND_LEAD_WEBHOOK_URL=https://crm.digitalelite.ir/webhooks/lead
