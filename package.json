{
  "name": "openreply",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "vercel-build": "prisma generate && prisma migrate deploy && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "check": "node scripts/quick-check.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:baseline": "tsx scripts/db-baseline.ts",
    "db:audit": "tsx scripts/db-audit.ts",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "worker": "tsx worker/dm-worker.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@next/env": "^16.2.11",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/config": "^7.9.1",
    "@tailwindcss/postcss": "^4",
    "@xyflow/react": "^12.11.2",
    "dotenv": "^17.4.2",
    "mariadb": "^3.5.3",
    "next": "^16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwindcss": "^4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "prisma": "^7.9.1",
    "tsx": "^4.22.1",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
