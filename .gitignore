# ==============================================================================
# OpenReply Standalone SaaS - Git Ignore Configuration
# Strict separation of concerns & comprehensive secret / artifact protection
# ==============================================================================

# 1. Dependency Directories
/node_modules/
/vendor/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Environment Variables & Secret Files (CRITICAL: Never commit credentials)
.env
.env.*
.env*.local
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
!.env.example

# Private Keys, Certificates & Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.id_rsa.pub

# 3. Next.js Build Outputs & Compiler Caches
/.next/
/out/
/build/
/dist/
/.turbo/
/.cache/
.eslintcache
*.tsbuildinfo
next-env.d.ts
/lib/generated/prisma/
/app/generated/prisma/

# 4. Testing & Code Coverage Reports
/coverage/
*.lcov
.nyc_output/

# 5. Application & Process Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock
build-output.txt

# 6. Database Dumps & Local Data Persistence
# Allow clean schema initialization scripts for Docker, ignore actual dumps/backups
*.sql
*.dump
*.sqlite
*.sqlite3
*.db
!deploy/init-db/*.sql
backups/
deploy/backups/
*.bak
*.backup
*.old

# 7. Archives, Backups & Binaries
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.exe
*.dll
*.so
*.dylib
cloudflared*

# 8. Operating System & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
*.tmp
*.temp

# IDE Configurations (keep personal settings out of repo)
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# 9. Scratch & Ad-hoc Root Test Scripts
search*.js
test-*.js
powershell.bat

# 10. External / Adjacent Project Protection
# Ensure booking system files or adjacent repositories cannot be accidentally pulled in
booking/
crm/
wamp/
wamp64/
